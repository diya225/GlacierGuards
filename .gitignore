# ============================================================
# GLOF EWS — .gitignore
# ============================================================

# Secrets — NEVER commit
.env
# GEE service account key (any JSON matching the GCP naming pattern)
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json
ServiceAccountKey.json

# Downloaded satellite data (can be re-fetched)
data/raw/
data/interim/
data/processed/

# Model weights
*.pt
*.pth
*.onnx
checkpoints/
models/weights/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints/

# IDEs
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Docker
.docker/

# Logs
*.log
logs/

# External datasets
data/external/
kaggle/*.zip
results.zip
glacierguards_kaggle.zip
